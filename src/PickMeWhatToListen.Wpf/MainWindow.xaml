<Window x:Class="PickMeWhatToListen.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Кого послушать?"
        Height="560" Width="760" MinHeight="460" MinWidth="640"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        Language="ru-RU">
    <!--
      Language="ru-RU" (not the WPF default "en-US") so date StringFormat
      bindings in the details panel below render Russian month names —
      the whole rest of the UI is Russian text, an English date would be
      an inconsistency, not a locale choice.
    -->
    <!--
      List/details layout (see docs/product-specs/visual-design-pass.md):
      the list column (left) is a self-contained, "bookended" management
      block — add toolbar on top, scrollable list in the middle, the main
      "pick random" action at the bottom. The details column (right) is
      the result/viewing pane, reflecting whatever is selected, whether by
      a row click or by a random pick.
    -->
    <Grid Margin="0">
        <!--
          List/details split 1:3 (list : details). MinWidth values sum to the
          window MinWidth so both panes stay readable at the floor.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="160"/>
            <ColumnDefinition Width="3*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!--
          List/details panels sit directly adjacent (no gap) so the pair
          reads as one continuous bordered block with a single internal
          divider: the list panel drops its right edge (BorderThickness
          "1,1,0,1" — no right edge) so it doesn't double up into a 2px
          seam with the details panel's own left edge (unchanged, all four
          sides from SurfaceCardStyle).
        -->
        <Border Grid.Column="0" BorderThickness="1,1,0,1" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Add-artist toolbar: primary "Добавить" on the input row, import demoted to a link underneath. -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ResponsiveScaleConverter}, ConverterParameter=36}"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Text="{Binding NewArtistName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddArtistCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Margin="0,0,0,0"
                                Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ResponsiveScaleConverter}, ConverterParameter=36}"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ResponsiveScaleConverter}, ConverterParameter=96}"
                                Content="Добавить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddArtistCommand}"/>
                    </Grid>
                    <Button Grid.Row="1"
                            Margin="0,8,0,0"
                            Content="Импорт из файла..."
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding ImportFromFileCommand}"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="2"
                         Margin="0,8,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Artists}"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ArtistRowContainerStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ArtistRowButtonStyle}"
                                    Command="{Binding DataContext.SelectArtistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Width="20"
                                               Text="&#x2714;"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding IsPicked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3"
                        Margin="0,0,0,0"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ResponsiveScaleConverter}, ConverterParameter=32}"
                        HorizontalAlignment="Stretch"
                        Content="Выбрать случайного"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PickRandomCommand}"/>
            </Grid>
        </Border>

        <!--
          Unlike the list panel, the details panel holds only text (name,
          dates, placeholder), which reads badly glued to the border — so
          it keeps a local Padding override, while SurfaceCardStyle itself
          defaults to 0 for panels (like the list one) that want their
          content flush with the border.
        -->
        <Border Grid.Column="1" Padding="12" Style="{StaticResource SurfaceCardStyle}">
            <!--
              NotifyOnTargetUpdated=True is required — without it Binding.TargetUpdated
              never fires and the storyboard below never starts.
            -->
            <Grid x:Name="DetailsContentPanel"
                  RenderTransformOrigin="0,0">
                <Grid.Tag>
                    <Binding NotifyOnTargetUpdated="True" Path="SelectedArtist"/>
                </Grid.Tag>
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="10"
                                                 To="0"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <TextBlock Text="Выберите исполнителя из списка или нажмите «Выбрать случайного»"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedArtist}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedArtist}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding SelectedArtist.Name}" Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding SelectedArtist.PickedAtUtc, StringFormat='Отмечен ✔ · {0:d MMMM yyyy}'}"
                               Visibility="{Binding SelectedArtist.IsPicked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding SelectedArtist.CreatedAtUtc, StringFormat='В списке с {0:d MMMM yyyy}'}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
