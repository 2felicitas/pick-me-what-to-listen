<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PickMeWhatToListen.Application\PickMeWhatToListen.Application.csproj" />
    <ProjectReference Include="..\PickMeWhatToListen.Infrastructure\PickMeWhatToListen.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    PT Root UI variable font (OFL-1.1, see Fonts/LICENSE.txt), embedded as a
    WPF pack resource so it's available at
    pack://application:,,,/.../Fonts/#PT Root UI VF without needing to be
    installed on the machine. Arbitrary files under Fonts/ aren't
    auto-included as Resource by the WPF SDK the way .xaml is, so both files
    are listed explicitly.

    Not Figtree: Figtree's Cyrillic support is an unmerged GitHub PR, not
    part of any released version, so it renders Cyrillic (the bulk of this
    app's UI text) via a fallback system font instead — see decisions log in
    docs/exec-plans/active/0006-typography-spacing-and-motion.md.
  -->
  <ItemGroup>
    <Resource Include="Fonts\PT-Root-UI_VF.ttf" />
    <None Include="Fonts\LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!--
    Debug-only diagnostic agent: lets an AI/dev tool inspect the running
    visual tree over XamlMcp. Scoped to the Debug configuration (App.xaml.cs
    guards the corresponding using/AttachXamlMcp() call with #if DEBUG) so
    it never lands in the self-contained single-file Release publish below.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="XamlMcp.Wpf" Version="1.0.0-preview.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Standalone .exe publish shape (see docs/product-specs/standalone-exe.md).
    Self-contained + single-file so the app runs on a clean Windows machine
    with no separate .NET runtime install. RuntimeIdentifier is fixed to
    win-x64 rather than left portable, since PublishSingleFile requires a
    concrete RID and this is a Windows-only WPF app.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
