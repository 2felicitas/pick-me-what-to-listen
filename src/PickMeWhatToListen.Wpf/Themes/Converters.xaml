<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:PickMeWhatToListen.Wpf.Converters">

    <!--
      Merged into Controls.xaml (not just declared in App.xaml) because
      RowIsSelectedConverter is used inside ArtistRowButtonStyle's
      Style.Triggers — a StaticResource referenced from within a Style or
      ControlTemplate defined in a separate merged ResourceDictionary file
      only resolves against that file's own MergedDictionaries, not the
      wider Application.Resources tree it ends up part of. Declaring the
      converters only in App.xaml (as before) throws a
      "cannot find resource" XamlParseException at first ListBox layout.
      See .cursor/rules/theming.mdc.
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <converters:RowIsSelectedConverter x:Key="RowIsSelectedConverter"/>
    <converters:ResponsiveScaleConverter x:Key="ResponsiveScaleConverter"/>

</ResourceDictionary>
